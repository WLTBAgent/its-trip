# Copy this file to secrets.toml and fill real values (do not commit secrets.toml)

PADDLE_OCR_TOKEN = "token_xxx"

# Multiple keys separated by comma, e.g. "sk-aaa,sk-bbb,sk-ccc"
SILICONFLOW_API_KEYS = "sk_xxx"
SILICONFLOW_BASE_URL = "https://api.siliconflow.cn/v1"

# Text model (extract / assess / plan / dispatch)
SILICONFLOW_MODEL = "deepseek-ai/DeepSeek-V4-Flash"

# Vision model (event understanding: image direct reading, optional)
SILICONFLOW_VISION_MODEL = "Qwen/Qwen3.5-27B"
SILICONFLOW_TIMEOUT_S = "90"
